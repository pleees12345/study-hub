# Copy to .env.local and fill in (temporary keys only)
GROQ_API_KEY=
VITE_GROQ_API_KEY=

# Optional: URL of a deployed Study Hub API proxy backend (see backend/server.mjs).
# When set, ALL AI + research traffic is routed through this single origin, which
# lets the app work behind a school firewall and keeps the Groq key off the device.
# VITE_API_BASE=https://your-proxy.example.com

# Optional: Microsoft Graph access token for Teams homework (local dev only)
# Paste a token from https://developer.microsoft.com/en-us/graph/graph-explorer to load live homework.
# The Vite proxy injects it as a Bearer token into /api/graph requests — no OAuth needed.
MS_GRAPH_TOKEN=
# VITE_MS_GRAPH_TOKEN=

# ==== Alternative: Microsoft sign-in (OAuth) ====
# Requires your own Azure AD app whose redirect URI matches the Vite origin.
# The Teams web client ID will NOT work here (it only redirects to teams.cloud.microsoft).
VITE_MS_CLIENT_ID=
# Optional, defaults to "https://login.microsoftonline.com/common"
VITE_MS_AUTHORITY=
