# Copy this file to backend/.env and fill in your key.
# The key stays ONLY on this server — it is never shipped to the app.

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Port the proxy listens on (defaults to 8787)
# PORT=8787

# Comma-separated list of allowed origins, or * (default) for any origin.
# ALLOWED_ORIGIN=*